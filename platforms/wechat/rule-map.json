{
  "format_version": 1,
  "platform": "wechat",
  "allowed_domains": [
    "developers.weixin.qq.com",
    "mp.weixin.qq.com"
  ],
  "rules": [
    {
      "id": "release-review-operations",
      "step_class": "upload/review/release",
      "ttl_days": 0,
      "official": {
        "url": "https://developers.weixin.qq.com/miniprogram/product/",
        "title": "微信小程序平台运营规范",
        "section": "审核规范与发布要求"
      },
      "verify_points": [
        "运营规范当前包含的分节结构（如注册规范、行为规范、内容标准、审核要求）",
        "涉及提审与发布要求的分节标题与入口"
      ]
    },
    {
      "id": "privacy-protection-declarations",
      "step_class": "privacy/permission",
      "ttl_days": 30,
      "official": {
        "url": "https://developers.weixin.qq.com/miniprogram/dev/framework/user-privacy/",
        "title": "用户隐私保护指引填写说明",
        "section": "隐私接口与声明配置"
      },
      "verify_points": [
        "需申报的隐私接口清单",
        "指引配置与生效条件",
        "用户授权与撤回要求"
      ]
    },
    {
      "id": "toolchain-devtools",
      "step_class": "toolchain/build",
      "ttl_days": 90,
      "official": {
        "url": "https://developers.weixin.qq.com/miniprogram/dev/devtools/download.html",
        "title": "微信开放文档",
        "section": "版本与下载"
      },
      "verify_points": [
        "当前稳定版与最低环境要求",
        "项目配置与构建行为兼容性变化"
      ]
    }
  ]
}
